{
  "name": "hotdrop-rebuild",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/web-client",
    "apps/desktop"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web-client",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:web": "npm run build --workspace=apps/web-client",
    "build:desktop": "npm run build:electron --workspace=apps/desktop",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "npm run typecheck --workspace=apps/web-client"
  }
}
